# Session signing / Filecoin session-key derivation secret.
# Use at least 32 random characters. Never reuse this example value.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Encryption key for user provider API keys and Filecoin session keys stored in D1.
# Use a different 32+ character random secret.
APP_ENCRYPTION_KEY=replace-with-another-32-random-character-secret

# Keep false in production. True allows localhost/private provider URLs for local LLM development.
ALLOW_UNSAFE_PROVIDER_URLS=false

# Optional: Filecoin RPC endpoint (defaults to calibration testnet)
FILECOIN_RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# Optional: Synapse source identifier
SYNAPSE_SOURCE=cross-session-memory-agent

# Optional: Memory limit (max turns to fetch for context)
MEMORY_LIMIT=10
